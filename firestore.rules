rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function superAdmin() {
      return signedIn()
        && request.auth.token.email == "venoaconsults@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /creatorProfiles/{uid} {
      allow read: if superAdmin() || owner(uid);
      allow create: if owner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if superAdmin()
        || (owner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.accountStatus == resource.data.accountStatus);
      allow delete: if superAdmin() || owner(uid);
    }

    match /creatorApplications/{uid} {
      allow read: if superAdmin() || owner(uid);
      allow create: if owner(uid)
        && request.auth.token.email_verified == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "PENDING";
      allow update: if superAdmin()
        || (owner(uid)
          && resource.data.status in ["PENDING", "MORE_INFO_REQUIRED"]
          && request.resource.data.status == resource.data.status
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email);
      allow delete: if superAdmin() || owner(uid);
    }

    match /creators/{uid} {
      allow read: if superAdmin()
        || owner(uid)
        || (resource.data.status == "APPROVED"
            && resource.data.public == true
            && resource.data.publicConsent == true);
      allow write: if superAdmin();
    }

    match /brands/{id} {
      allow read: if superAdmin() || resource.data.public == true;
      allow write: if superAdmin();
    }

    match /reels/{id} {
      allow read: if superAdmin() || resource.data.public == true;
      allow write: if superAdmin();
    }

    match /digitalPages/{id} {
      allow read: if superAdmin() || resource.data.public == true;
      allow write: if superAdmin();
    }

    match /campaigns/{id} {
      allow read: if superAdmin() || resource.data.public == true || signedIn();
      allow write: if superAdmin();
    }

    match /campaignApplications/{id} {
      allow create: if signedIn() && request.auth.token.email_verified == true
        && request.resource.data.uid == request.auth.uid;
      allow read: if superAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if superAdmin();
    }

    match /leads/{id} {
      allow create: if true;
      allow read, update, delete: if superAdmin();
    }

    match /portfolioLeads/{id} {
      allow create: if true;
      allow read, update, delete: if superAdmin();
    }

    match /settings/{id} {
      allow read, write: if superAdmin();
    }

    match /auditLogs/{id} {
      allow read, create: if superAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
